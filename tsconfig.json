{
  "compilerOptions": {
    "target": "ES2024", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2024", "ESNext.Disposable"], "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"],
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "noEmit": true, "resolveJsonModule": true
  },
  "include": ["cloud/src/**/*.ts", "cloud/tests/**/*.ts", "vitest.config.ts"]
}
