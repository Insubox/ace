{
  "$defs": {
    "ProjectId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "Text": {
      "description": "Nonempty text; unlike identifiers this may contain spaces and Unicode.",
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "Timestamp": {
      "description": "UTC Unix seconds. The caller supplies time; the kernel has no ambient clock.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "$id": "https://ace.org.ai/schemas/v1/project.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "$ref": "#/$defs/Timestamp"
    },
    "id": {
      "$ref": "#/$defs/ProjectId"
    },
    "name": {
      "$ref": "#/$defs/Text"
    }
  },
  "required": [
    "id",
    "name",
    "created_at"
  ],
  "title": "Project",
  "type": "object"
}
