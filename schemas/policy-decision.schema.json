{
  "$defs": {
    "CandidateId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "ContentHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "Decision": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "kill",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/KillReason"
            }
          },
          "required": [
            "action",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "advance",
              "type": "string"
            },
            "stage": {
              "$ref": "#/$defs/EvaluationStage"
            }
          },
          "required": [
            "action",
            "stage"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "hold",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/HoldReason"
            }
          },
          "required": [
            "action",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "elite",
              "type": "string"
            }
          },
          "required": [
            "action"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Reserved for a separate privileged promotion decision.",
          "properties": {
            "action": {
              "const": "champion",
              "type": "string"
            }
          },
          "required": [
            "action"
          ],
          "type": "object"
        }
      ]
    },
    "EvaluationStage": {
      "enum": [
        "l0",
        "l1",
        "l2",
        "l3"
      ],
      "type": "string"
    },
    "EvidenceId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "HoldReason": {
      "enum": [
        "context_mismatch",
        "incomplete_evidence",
        "evaluation_error",
        "oracle_error",
        "future_evidence"
      ],
      "type": "string"
    },
    "KillReason": {
      "enum": [
        "hard_check_failed",
        "hard_constraint_failed",
        "oracle_failed",
        "evaluation_failed"
      ],
      "type": "string"
    },
    "Text": {
      "description": "Nonempty text; unlike identifiers this may contain spaces and Unicode.",
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "Timestamp": {
      "description": "UTC Unix seconds. The caller supplies time; the kernel has no ambient clock.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "$id": "https://ace.org.ai/schemas/v1/policy-decision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate": {
      "$ref": "#/$defs/CandidateId"
    },
    "decided_at": {
      "$ref": "#/$defs/Timestamp"
    },
    "decision": {
      "$ref": "#/$defs/Decision"
    },
    "evidence": {
      "$ref": "#/$defs/EvidenceId"
    },
    "evidence_hash": {
      "$ref": "#/$defs/ContentHash"
    },
    "inputs_hash": {
      "$ref": "#/$defs/ContentHash"
    },
    "policy_version": {
      "$ref": "#/$defs/Text"
    },
    "reasons": {
      "items": {
        "$ref": "#/$defs/Text"
      },
      "type": "array"
    }
  },
  "required": [
    "candidate",
    "evidence",
    "evidence_hash",
    "policy_version",
    "decision",
    "reasons",
    "inputs_hash",
    "decided_at"
  ],
  "title": "PolicyDecision",
  "type": "object"
}
