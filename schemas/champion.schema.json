{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "hash": {
          "$ref": "#/$defs/ContentHash"
        },
        "location": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "location",
        "hash"
      ],
      "type": "object"
    },
    "CandidateId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "CellId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "ChampionId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "ContentHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "EvalSpecId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "EvidenceId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "OracleId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "Text": {
      "description": "Nonempty text; unlike identifiers this may contain spaces and Unicode.",
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "Timestamp": {
      "description": "UTC Unix seconds. The caller supplies time; the kernel has no ambient clock.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "VersionedEvalSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/EvalSpecId"
        },
        "version": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    },
    "VersionedOracle": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/OracleId"
        },
        "version": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    }
  },
  "$id": "https://ace.org.ai/schemas/v1/champion.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "candidate": {
      "$ref": "#/$defs/CandidateId"
    },
    "cell": {
      "$ref": "#/$defs/CellId"
    },
    "environment_hash": {
      "$ref": "#/$defs/ContentHash"
    },
    "evalspec": {
      "$ref": "#/$defs/VersionedEvalSpec"
    },
    "id": {
      "$ref": "#/$defs/ChampionId"
    },
    "oracle": {
      "$ref": "#/$defs/VersionedOracle"
    },
    "policy_version": {
      "$ref": "#/$defs/Text"
    },
    "qualification_evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceId"
      },
      "type": "array",
      "uniqueItems": true
    },
    "qualified_at": {
      "$ref": "#/$defs/Timestamp"
    }
  },
  "required": [
    "id",
    "cell",
    "candidate",
    "artifact",
    "environment_hash",
    "evalspec",
    "oracle",
    "qualification_evidence",
    "policy_version",
    "qualified_at"
  ],
  "title": "Champion",
  "type": "object"
}
