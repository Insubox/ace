{
  "$defs": {
    "ContentHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "JudgeAnswers": {
      "additionalProperties": false,
      "properties": {
        "architectural_fit": {
          "description": "Ordered probabilities: good, uncertain, poor.",
          "items": {
            "$ref": "#/$defs/Probability"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "behavior_change_risk": {
          "$ref": "#/$defs/Probability"
        },
        "novelty": {
          "description": "Ordered probabilities: duplicate, incremental, new, highly novel.",
          "items": {
            "$ref": "#/$defs/Probability"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "prior_failure_similarity": {
          "$ref": "#/$defs/Probability"
        }
      },
      "required": [
        "behavior_change_risk",
        "prior_failure_similarity",
        "architectural_fit",
        "novelty"
      ],
      "type": "object"
    },
    "JudgeFault": {
      "enum": [
        "unavailable",
        "timeout",
        "invalid_response",
        "budget_exhausted"
      ],
      "type": "string"
    },
    "JudgeResult": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "$ref": "#/$defs/Text"
        },
        "answers": {
          "$ref": "#/$defs/JudgeAnswers"
        },
        "calibration_version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "input_hash": {
          "$ref": "#/$defs/ContentHash",
          "description": "Raw SHA-256 of the exact frozen public context bytes."
        },
        "latency_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "model": {
          "$ref": "#/$defs/Text"
        },
        "provider": {
          "$ref": "#/$defs/Text"
        },
        "question_schema_version": {
          "$ref": "#/$defs/Text"
        },
        "request_hash": {
          "$ref": "#/$defs/ContentHash",
          "description": "Raw SHA-256 of the actual provider request bytes retained by the adapter."
        },
        "revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "stage": {
          "$ref": "#/$defs/JudgeStage"
        },
        "token_usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/TokenUsage"
            },
            {
              "type": "null"
            }
          ],
          "description": "None means not reported, never zero-token inference."
        }
      },
      "required": [
        "schema_version",
        "provider",
        "adapter_version",
        "model",
        "stage",
        "question_schema_version",
        "input_hash",
        "request_hash",
        "latency_ms",
        "answers"
      ],
      "type": "object"
    },
    "JudgeStage": {
      "enum": [
        "l1a",
        "l1b"
      ],
      "type": "string"
    },
    "Probability": {
      "format": "double",
      "maximum": 1.0,
      "minimum": 0.0,
      "type": "number"
    },
    "Text": {
      "description": "Nonempty text; unlike identifiers this may contain spaces and Unicode.",
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "TokenUsage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "output_tokens": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens"
      ],
      "type": "object"
    }
  },
  "$id": "https://ace.org.ai/schemas/v1/judge-attempt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "fault": {
      "anyOf": [
        {
          "$ref": "#/$defs/JudgeFault"
        },
        {
          "type": "null"
        }
      ]
    },
    "input_hash": {
      "$ref": "#/$defs/ContentHash"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/JudgeResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "input_hash"
  ],
  "title": "JudgeAttempt",
  "type": "object"
}
