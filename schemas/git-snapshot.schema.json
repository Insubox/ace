{
  "$defs": {
    "CandidateId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "ContentHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "ExperimentId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "KnowledgeId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "ProtocolVersion": {
      "const": 1,
      "type": "integer"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "champion": {
      "anyOf": [
        {
          "$ref": "#/$defs/CandidateId"
        },
        {
          "type": "null"
        }
      ]
    },
    "experiment": {
      "$ref": "#/$defs/ExperimentId"
    },
    "files": {
      "additionalProperties": {
        "$ref": "#/$defs/ContentHash"
      },
      "type": "object"
    },
    "knowledge": {
      "$ref": "#/$defs/KnowledgeId"
    },
    "report_hash": {
      "$ref": "#/$defs/ContentHash"
    },
    "schema_version": {
      "$ref": "#/$defs/ProtocolVersion"
    }
  },
  "required": [
    "schema_version",
    "experiment",
    "report_hash",
    "knowledge",
    "files"
  ],
  "title": "Snapshot",
  "type": "object"
}
