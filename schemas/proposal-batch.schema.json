{
  "$defs": {
    "CandidateId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "CellId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "Generator": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "$ref": "#/$defs/Text"
        },
        "provider": {
          "$ref": "#/$defs/Text"
        },
        "revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "type": "object"
    },
    "Proposal": {
      "additionalProperties": false,
      "properties": {
        "generator": {
          "$ref": "#/$defs/Generator"
        },
        "id": {
          "$ref": "#/$defs/CandidateId"
        },
        "strategy": {
          "$ref": "#/$defs/Text"
        },
        "wat": {
          "maxLength": 32768,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "wat",
        "strategy",
        "generator"
      ],
      "type": "object"
    },
    "ProtocolVersion": {
      "const": 1,
      "type": "integer"
    },
    "Text": {
      "description": "Nonempty text; unlike identifiers this may contain spaces and Unicode.",
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "items": {
        "$ref": "#/$defs/Proposal"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    },
    "cell": {
      "$ref": "#/$defs/CellId"
    },
    "schema_version": {
      "$ref": "#/$defs/ProtocolVersion"
    }
  },
  "required": [
    "schema_version",
    "cell",
    "candidates"
  ],
  "title": "Batch",
  "type": "object"
}
